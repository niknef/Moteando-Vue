# Copiar este archivo como .env y completar los valores.
# El .env está en .gitignore: nunca se sube al repo. Este .env.example sí (no tiene secretos).

# ─── Supabase ─────────────────────────────────────────────────────
# Dashboard del proyecto: https://supabase.com/dashboard/project/zvvhnmvosdthvuuukjzt
# URL del proyecto (Project Settings → Data API). Según supabase/.temp/project-ref debería ser esta:
VITE_SUPABASE_URL=https://zvvhnmvosdthvuuukjzt.supabase.co
# Clave pública "anon" (Project Settings → API Keys → Legacy API keys → anon public)
VITE_SUPABASE_KEY=

# ─── OpenRouteService (cálculo de rutas en /map) ──────────────────
# https://openrouteservice.org/dev/#/home → loguearse → Dashboard → Tokens
VITE_ORS_KEY=

# ─── Nominatim (búsqueda de direcciones en /map) ──────────────────
# Servidor público de OpenStreetMap, no necesita clave
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
